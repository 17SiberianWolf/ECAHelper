# 项目内部目录（记忆/配置，不入库）
.workbuddy/

# Python 缓存
__pycache__/
*.pyc

# 虚拟环境
.venv/
venv/

# 运行时生成的数据库与导出（含员工隐私工时数据）
data/*.db
data/exports/*
!data/exports/.gitkeep

# 自动导入完成标记（运行时生成的自举门槛）
data/.auto_import.done

# 原始输入工时表（含员工隐私，体积大，不入库）
OriginSource/

# PyInstaller 构建产物（ECAHelper.spec 作为唯一真源需入库，故不忽略 *.spec）
build/
dist/

# 临时 / 日志
*.log
_cleanup*
_probe*
_st.txt
_dbg*
_junk*
_finalize*
_tmp*
# 子代理 / 工具遗留的临时排查产物（下划线开头的文本与目录，
# 如 _diag_docs.txt / _restore_docs.txt / _tmp_numstat.txt / _qa_out\）
_*.txt
_*/
